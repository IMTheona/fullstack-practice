<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.theona.mapper.ArticleMapper">
    <!-- 在这里编写 SQL 语句 -->
    <select id="list" resultType="com.theona.pojo.Article">
        select * from article
        <where>
            and create_user = #{userId}
            <if test="categoryId!=null">
                and category_id=#{categoryId}
            </if>

            <if test="state!=null">
                and state=#{state}
            </if>
        </where>
    </select>
</mapper>